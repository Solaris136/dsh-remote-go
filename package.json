{
  "name": "dsh-remote-go",
  "version": "0.1.0",
  "description": "DSH 插件：在本地 DSH 里通过 SSH 使用远端 DSH（主机条切换、整窗接管、连接进度与日志、重启/关闭远端、远端文件下载、只读主机列表；插件自带 Node + npx，数据留在远端 ~/.dsh） | DSH plugin: use a remote DSH over SSH inside your local DSH (host switcher, full-window UI, connect progress and log, remote restart/stop, remote file downloads, read-only host list; plugin-managed Node + npx, data stays in the remote ~/.dsh)",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "remote",
    "ssh",
    "remote-development"
  ],
  "license": "MIT",
  "author": "Solaris136",
  "homepage": "https://github.com/Solaris136/dsh-remote-go#readme",
  "bugs": {
    "url": "https://github.com/Solaris136/dsh-remote-go/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solaris136/dsh-remote-go.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "dsh": ">=0.2.2-rc.3",
    "node": ">=24"
  },
  "sideEffects": [
    "./client.js"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "vendor/ssh2.bundle.cjs",
    "vendor/THIRD_PARTY_NOTICES.md",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.28.2",
    "js-yaml": "^5.5.0",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "1.17.0"
  },
  "scripts": {
    "test": "node --test \"test/unit/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:web": "node --test \"test/integration/web.e2e.js\"",
    "test:desktop": "node --test \"test/integration/desktop.e2e.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.js\" \"test/integration/*.e2e.js\"",
    "test:integration:local": "node --test --test-concurrency=1 test/integration/sim.test.js test/integration/remote-restart.test.js test/integration/stop-remote.test.js",
    "test:integration:external": "node --test --test-concurrency=1 test/integration/client-ui.test.js test/integration/remote-proxy.test.js test/integration/web.e2e.js test/integration/browser-carrier.test.js test/integration/guest-tools.e2e.js test/integration/stop-remote.browser.test.js",
    "sim:remote": "node e2e/sim/simulated-remote.mjs --self-test",
    "test:coverage": "node scripts/check-coverage.mjs",
    "lint": "node scripts/check-repo.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:pr-title": "node scripts/check-pr-title.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate": "node scripts/check-repo.mjs && prettier --check . && node scripts/check-syntax.mjs && node scripts/check-workflows.mjs && node scripts/pack-check.mjs && node scripts/check-coverage.mjs",
    "verify": "node scripts/check-repo.mjs && prettier --check . && node scripts/check-syntax.mjs && node scripts/check-workflows.mjs && node scripts/pack-check.mjs && node scripts/check-coverage.mjs && node --test --test-concurrency=1 \"test/integration/*.test.js\" \"test/integration/*.e2e.js\"",
    "build:vendor": "node scripts/build-vendor.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "pack:check:tarball": "node scripts/pack-check.mjs --find artifacts",
    "prepack": "node scripts/build-vendor.mjs && git diff --exit-code -- vendor/"
  }
}
