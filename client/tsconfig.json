{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "jsx": "preserve",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
