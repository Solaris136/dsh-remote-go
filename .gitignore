.DS_Store

# Build, packaging and coverage output
artifacts/
*.tgz
coverage/
.pnpm-store/
*.tmp

# `pnpm build` emits the published layout into dist/ (`index.ts` -> dist/index.js,
# `src/**/*.ts` -> dist/src/**/*.js, plus the composed browser half dist/client.js). Since P1e
# the artifacts are generated output, not source, and are no longer committed.
#
# The published tarball ships exactly that `dist/` tree: `package.json` `exports` and `files[]`
# point into it, and `prepack` only verifies the build (no staging copy). The three root entries
# below are legacy guardrails from the build that emitted in place; `scripts/build.mjs` deletes
# such a file if an old checkout still has one, and these patterns keep it out of a commit.
/dist/
/index.js
/src/**/*.js
/client.js

# Local environment and secrets (never commit credentials)
.env
.env.*
!.env.example
*.pem
*.key
id_*
!id_*.example

# Editor and OS noise
.idea/
.vscode/
Thumbs.db

e2e/sim/.state.json
e2e/sim/home/
