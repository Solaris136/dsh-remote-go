node_modules/
_research/
_tools/
# Agent worktrees live here (DSH-specific); they are never part of the package.
.agents/
e2e/artifacts/
*.log
.DS_Store

# Build, packaging and coverage output
artifacts/
*.tgz
coverage/
.pnpm-store/
*.tmp

# `pnpm build` emits the published layout into dist/ (`index.ts` -> dist/index.js,
# `src/**/*.ts` -> dist/src/**/*.js, plus the composed browser half dist/client.js). Since P1e
# the artifacts are generated output, not source, and are no longer committed.
#
# The published tarball still ships them at the package root: `prepack` runs
# scripts/stage-publish.mjs, which copies dist/ to `index.js` / `client.js` / `src/**/*.js`, and
# `postpack` removes those copies again. The root entries below therefore exist only for the
# duration of a `pnpm pack`, and `files[]` in package.json is honoured regardless of .gitignore.
/dist/
/index.js
/src/**/*.js
/client.js

# Local environment and secrets (never commit credentials)
.env
.env.*
!.env.example
*.pem
*.key
id_*
!id_*.example

# Editor and OS noise
.idea/
.vscode/
Thumbs.db

e2e/sim/.state.json
e2e/sim/home/
