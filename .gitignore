.agents/
e2e/artifacts/
*.log
.DS_Store

# Build, packaging and coverage output
artifacts/
*.tgz
coverage/
.pnpm-store/
*.tmp

# `pnpm build` emits the published layout into dist/ (`index.ts` -> dist/index.js,
# `src/**/*.ts` -> dist/src/**/*.js, plus the composed browser half dist/client.js). Since P1e
# the artifacts are generated output, not source, and are no longer committed.
#
# The published tarball ships the `dist/` tree plus one hand-written file: `index.js` is the entry
# the DSH loader opens for a linked plugin (`<plugin dir>/index.js`), so it is a source shim that
# re-exports `dist/` and stays tracked. The remaining root entries are legacy guardrails from the
# build that emitted in place; `scripts/build.mjs` deletes such a file if an old checkout still has
# one, and these patterns keep it out of a commit.
/dist/
/src/**/*.js
/client.js

# Local environment and secrets (never commit credentials)
.env
.env.*
!.env.example
*.pem
*.key
id_*
!id_*.example

# Editor and OS noise
.idea/
.vscode/
Thumbs.db

