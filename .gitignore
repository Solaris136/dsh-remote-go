# Agent worktrees live here (DSH-specific); they are never part of the package.
.agents/
e2e/artifacts/
*.log
.DS_Store

# Build, packaging and coverage output
artifacts/
*.tgz
coverage/
.pnpm-store/
*.tmp

# `pnpm build` emits index.js and src/**/*.js next to their .ts sources (decision D1), and composes
# client.js from client/src/main.ts + client/template.js (P3a). Since P1e they are generated output,
# not source, and are no longer committed. The published tarball still ships them: `files[]` in
# package.json is honoured regardless of .gitignore by pnpm pack.
/index.js
/src/**/*.js
/client.js

# Local environment and secrets (never commit credentials)
.env
.env.*
!.env.example
*.pem
*.key
id_*
!id_*.example

# Editor and OS noise
.idea/
.vscode/
Thumbs.db

