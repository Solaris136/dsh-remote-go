# Generated, vendored or recorded material: never formatted by the toolchain.
node_modules/
vendor/
artifacts/
coverage/
.pnpm-store/
.agents/

# Build output of `pnpm build` (tsc emits next to each source, D1). Formatting it would fight
# the emitter and turn every build into a diff. `client.js` is deliberately NOT here: its build
# (scripts/build-client.mjs) ends with prettier using this same config, so keeping it in the
# checked set proves the artifact's style instead of exempting it.
src/**/*.js
/index.js

# Captured E2E output keeps its byte-level form.
e2e/artifacts/

# Lockfiles are managed by pnpm, not by a formatter.
pnpm-lock.yaml

# Markdown is hand-wrapped for review; formatting it would rewrap every doc.
*.md
