#!/bin/sh
# Optional pre-commit gate. Enable once per clone:
#   git config core.hooksPath .githooks
#
# Kept intentionally small: repository conventions (required files, version parity,
# secret/line hygiene, workflow pins), a syntax parse and the formatting check. The full
# gate (coverage floors, integration, packaging) runs in CI via `pnpm run verify`.
set -eu

root="$(git rev-parse --show-toplevel)"
cd "$root"

if [ ! -d node_modules ]; then
  echo "[pre-commit] node_modules is missing; run: pnpm install --frozen-lockfile --ignore-scripts" >&2
  exit 1
fi

node scripts/check-repo.mjs
node scripts/check-syntax.mjs
pnpm exec prettier --check .
